
#include <iostream>
#include <vector>
#include <queue>
using namespace std;

// BFS Traversal Function
void BFS(int start, vector<int> adj[], bool visited[]) {

    queue<int> q;

    // Mark starting vertex as visited
    visited[start] = true;
    q.push(start);

    while (!q.empty()) {

        int vertex = q.front();
        q.pop();

        cout << vertex << " ";

        // Visit all adjacent vertices
        for (int i = 0; i < adj[vertex].size(); i++) {

            int neighbour = adj[vertex][i];

            if (!visited[neighbour]) {
                visited[neighbour] = true;
                q.push(neighbour);
            }
        }
    }
}

int main() {
    int vertices, edges;

    cout << "Enter the number of vertices: ";
    cin >> vertices;

    cout << "Enter the number of edges: ";
    cin >> edges;

    vector<int> adj[vertices];

    // Taking edges as input
    cout << "Enter the edges (source destination):\n";

    for (int i = 0; i < edges; i++) {
        int u, v;
        cin >> u >> v;

        // Undirected graph
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    bool visited[vertices] = {false};

    int start;

    cout << "Enter the starting vertex: ";
    cin >> start;

    cout << "\nBFS Traversal: ";
    BFS(start, adj, visited);

    cout << endl;

    return 0;
}
